{
  "data_dir": "data",
  "artifacts_dir": "artifacts",
  "submissions_dir": "submissions",
  "target": "accepted",
  "id": "id",
  "metric": "roc_auc",
  "model": "random_forest",
  "model_params": {
    "n_estimators": 1000,
    "max_depth": 35,
    "min_samples_leaf": 2,
    "max_features": "sqrt",
    "n_jobs": 1
  },
  "validation_method": "stratified_kfold",
  "validation_size": 0.2,
  "n_splits": 5,
  "master_seed": 42,
  "preprocessing": {
    "scale_numeric": true,
    "add_missing_indicators": true,
    "log1p_columns": [],
    "missing_category_token": "__MISSING__",
    "method": "default"
  },
  "run_name": "random_forest_submission"
}
