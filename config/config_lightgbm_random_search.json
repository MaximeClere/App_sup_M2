{
  "data_dir": "data",
  "artifacts_dir": "artifacts",
  "submissions_dir": "submissions",
  "target": "accepted",
  "id": "id",
  "metric": "roc_auc",
  "model": "lightgbm",
  "model_params": {
    "objective": "binary",
    "n_estimators": 500,
    "learning_rate": 0.05,
    "max_depth": 5,
    "num_leaves": 31,
    "subsample": 0.8,
    "subsample_freq": 1,
    "colsample_bytree": 0.8,
    "reg_lambda": 1.0,
    "n_jobs": 1
  },
  "validation_method": "stratified_kfold",
  "validation_size": 0.2,
  "n_splits": 5,
  "master_seed": 42,
  "preprocessing": {
    "scale_numeric": true,
    "add_missing_indicators": true,
    "log1p_columns": [],
    "missing_category_token": "__MISSING__",
    "method": "default"
  },
  "run_name": "lightgbm_random_search",
  "hyperparameter_search": {
    "method": "random",
    "parameters": {
      "n_estimators": {
        "distribution": "randint",
        "low": 300,
        "high": 801
      },
      "learning_rate": {
        "distribution": "loguniform",
        "low": 0.001,
        "high": 0.1
      },
      "max_depth": [
        -1,
        10,
        12,
        15,
        20,
        25
      ],
      "num_leaves": {
        "distribution": "randint",
        "low": 15,
        "high": 64
      },
      "min_child_samples": {
        "distribution": "randint",
        "low": 10,
        "high": 51
      },
      "colsample_bytree": {
        "distribution": "uniform",
        "low": 0.7,
        "high": 1.0
      },
      "reg_lambda": {
        "distribution": "loguniform",
        "low": 0.1,
        "high": 10.0
      }
    },
    "cv": 5,
    "n_iter": 20,
    "n_jobs": 1
  }
}
