{
  "data_dir": "data",
  "artifacts_dir": "artifacts",
  "submissions_dir": "submissions",
  "target": "accepted",
  "id": "id",
  "metric": "roc_auc",
  "model": "xgboost",
  "model_params": {
    "objective": "binary:logistic",
    "eval_metric": "logloss",
    "n_estimators": 700,
    "learning_rate": 0.01,
    "max_depth": 15,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_lambda": 1.0,
    "min_child_weight": 1.0,
    "tree_method": "hist",
    "n_jobs": 1
  },
  "validation_method": "stratified_kfold",
  "validation_size": 0.2,
  "n_splits": 5,
  "master_seed": 42,
  "preprocessing": {
    "scale_numeric": true,
    "add_missing_indicators": true,
    "log1p_columns": [],
    "missing_category_token": "__MISSING__",
    "method": "default"
  },
  "run_name": "xgboost_extended_random_search",
  "hyperparameter_search": {
    "method": "random",
    "parameters": {
      "max_depth": [10, 12, 15, 18, 20, 25, 30, 35],
      "learning_rate": {
        "distribution": "loguniform",
        "low": 0.003,
        "high": 0.03
      },
      "reg_lambda": {
        "distribution": "loguniform",
        "low": 0.1,
        "high": 5.0
      }
    },
    "cv": 5,
    "n_iter": 60,
    "n_jobs": 1
  }
}
