{
  "data_dir": "data",
  "artifacts_dir": "artifacts",
  "submissions_dir": "submissions",
  "target": "accepted",
  "id": "id",
  "metric": "roc_auc",
  "model": "xgboost",
  "model_params": {
    "objective": "binary:logistic",
    "eval_metric": "logloss",
    "n_estimators": 500,
    "learning_rate": 0.01,
    "max_depth": 15,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_lambda": 1.0,
    "tree_method": "hist",
    "n_jobs": 1
  },
  "validation_method": "stratified_kfold",
  "validation_size": 0.2,
  "n_splits": 5,
  "master_seed": 42,
  "preprocessing": {
    "scale_numeric": true,
    "add_missing_indicators": true,
    "log1p_columns": [],
    "missing_category_token": "__MISSING__",
    "method": "default"
  },
  "run_name": "xgboost_feature_engineering",
  "hyperparameter_search": {
    "method": "grid",
    "parameters": {
      "max_depth": [
        10,
        12,
        15,
        20
      ],
      "learning_rate": [
        0.001,
        0.01,
        0.1
      ]
    },
    "cv": 5,
    "n_jobs": 1
  }
}
